# instacode – Umgebungsvariablen
# Lokal: Datei nach .env kopieren und Werte eintragen. Auf Railway: unter "Variables" eintragen.
# Niemals echte Schlüssel in den Quellcode oder ins Git-Repository schreiben.

# --- Grundlagen ---
NODE_ENV=production
# Öffentliche Adresse des Shops, ohne "/" am Ende
BASE_URL=https://instacode.store
# Ordner für die SQLite-Datenbank. Auf Railway: /data (dort das Volume einhängen)
DATA_DIR=/data
# PORT setzt Railway automatisch. Lokal Standard 3000.
# PORT=3000

# --- Sicherheit (je 64 zufällige Zeichen, z. B. aus einem Passwort-Generator) ---
SESSION_SECRET=
# Verschlüsselt die gespeicherten Codes. Nach dem ersten Start NIE MEHR ändern.
CODES_KEY=

# --- Stripe (zuerst Test-Schlüssel sk_test_...) ---
# Mit sk_test_ läuft der Shop im Testmodus (Testcodes, Generator aktiv).
# Mit sk_live_ läuft er live: nur echte Codes aus dem Lager, Generator gesperrt.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Öffentlicher Schlüssel (pk_test_… / pk_live_…) für die Express-Buttons Apple Pay, Google Pay, PayPal, Link.
# Ohne ihn gibt es nur den normalen Bezahlweg über die Stripe-Zahlungsseite.
STRIPE_PUBLISHABLE_KEY=
# Optional: Zahlungsarten für die Beschriftung festlegen statt sie aus Stripe zu lesen, z. B. apple_pay,google_pay,paypal,link,card
# PAY_METHODS=
# Klarna wird aus Stripe erkannt. Ohne eigene Einstellung im Admin gilt Klarna nur für Spiele-Keys und Software,
# weil Klarna Guthaben-, Geschenk- und Prepaid-Karten verbietet. 1 = Klarna ohne Stripe-Abfrage als aktiv behandeln (nur Vorschau).
# KLARNA_AVAILABLE=

# --- Automatische Auslieferung ---
# 1 = bezahlte Bestellungen sofort ausliefern (wenn die Regeln erfüllt sind), 0 = alles von Hand prüfen
AUTO_DELIVERY=1
# Höchster Bestellwert in Euro für die Sofortlieferung
AUTO_MAX_EUR=50
# Höchstens so viel Euro pro Kunde (E-Mail) in 24 Stunden automatisch
AUTO_MAX_DAY_EUR=150
# Testmodus: 0 schaltet den Testcode-Generator ab (dann nur hochgeladene Testcodes)
TEST_CODES=1

# --- E-Mail über Resend ---
RESEND_API_KEY=
MAIL_FROM=Instacode <hallo@instacode.store>
MAIL_FOOTER=instacode.store
# Support-Adresse, die im Shop, in Mails und im Chat angezeigt wird
SUPPORT_EMAIL=support@instacode.store
# Rechnung als eigene Mail nach jeder Lieferung (1 = an). Erst einschalten, wenn Verkäuferangaben und Steuerhinweis geprüft sind.
INVOICE_MAIL=0
# Bewertungsanfrage per E-Mail (nur mit Einwilligung des Kunden): Stunden nach der Lieferung (Standard 72), REVIEW_MAILS=0 schaltet sie ab
# REVIEW_DELAY_H=72
# REVIEW_MAILS=1
# Verkäuferangaben auf der Rechnung, Zeilen mit | trennen
INVOICE_SELLER=
# Steuerhinweis unter der Rechnung (mit Steuerberater abstimmen, z. B. zu Mehrzweckgutscheinen)
INVOICE_TAX_NOTE=Alle Preise sind Endpreise.

# --- Optional: Google-Login ---
GOOGLE_CLIENT_ID=

# --- Optional: Trustpilot-Widget (erst eintragen, wenn dein Trustpilot-Profil echte Bewertungen hat) ---
# Business-Unit-ID und Template-ID findest du im Trustpilot-Business-Konto unter Integrationen › TrustBox.
# Das Widget lädt erst, wenn Besucher im Cookie-Banner „Alle erlauben“ wählen.
TRUSTPILOT_BUSINESS_ID=
TRUSTPILOT_TEMPLATE_ID=
TRUSTPILOT_URL=https://de.trustpilot.com/review/instacode.store

# --- Reloadly (automatischer Einkauf von Codes und Handy-Aufladungen) ---
# Reloadly-Dashboard › Developers › API Settings. Nur bei Railway eintragen, nie ins Git.
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
# 1 = Testumgebung von Reloadly (keine echten Einkäufe)
RELOADLY_SANDBOX=0
# Aufschlag auf den Reloadly-Einkaufspreis für Karten in Fremdwährung (0.06 = 6 %)
RL_MARGIN=0.06
# 1 = Bestandsprüfung einschalten (ausverkaufte Beträge sperren). Standard: nie ausverkauft, fehlende Codes werden bei Reloadly gekauft oder von Hand geliefert
SOLDOUT=0
# 1 = eigene Produkte ohne Originalbild trotzdem anzeigen
SHOW_PLAIN=0

# --- Preise ---
# Mehrwertsteuer in Prozent, wird auf jeden Produktpreis aufgeschlagen (0 = aus)
VAT_RATE=0
# Feste Servicegebühr pro Bestellung in Euro, inkl. MwSt. (0 = aus)
SERVICE_FEE=4.99

# --- Schnell-Login (Knöpfe erscheinen automatisch, sobald die Werte gesetzt sind) ---
# Apple: Services ID, Team ID, Key ID und der Inhalt der .p8-Datei (Zeilenumbrüche als \n)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Discord / Twitch: Redirect-URL jeweils https://www.instacode.store/auth/discord/callback bzw. /auth/twitch/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# SMS-Code über Twilio Verify
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=

# --- Abos (Pro, Premium, Max) ---
# Zahlungsarten im Abo-Checkout (fest, Klarna ist gesperrt). Apple Pay und Google Pay laufen über "card".
# Lehnt Stripe eine Art ab (z. B. Link im Konto aus), nimmt der Shop automatisch nur "card".
ABO_PAYMENT_METHODS=card,link
# Stripe-Webhook (Dashboard › Entwickler › Webhooks, Ziel https://<domain>/api/stripe/webhook) braucht zusätzlich zu den
# bisherigen Ereignissen: checkout.session.completed, checkout.session.expired, invoice.paid, invoice.payment_failed,
# customer.subscription.created, customer.subscription.updated, customer.subscription.deleted

# --- Mia, KI-Shopberaterin (Claude von Anthropic) ---
# Schlüssel aus der Anthropic Console (API Keys). Leer = Mia antwortet im einfachen Modus ohne KI (Katalogsuche + feste Antworten).
# Nur bei Railway eintragen, nie ins Git. Lokal ohne Internet: sk-ant-dev-attrappe (feste Testantworten mit Werkzeugaufrufen).
ANTHROPIC_API_KEY=
# Modell (Standard: claude-haiku-5-5)
ANTHROPIC_MODEL=claude-haiku-5-5
# Kosten-Bremse: höchstens so viele Anfragen an Claude pro Tag (deutsche Zeit), danach einfacher Modus
AI_DAILY_LIMIT=1500
# 0 = Mia zeigt im Shop keine Vorschläge (der Chat bleibt)
AI_PROACTIVE=1
# Optional: Anfragen pro IP und Minute / pro IP und Stunde / pro Chat-Sitzung und Stunde
# AI_RATE_MIN=8
# AI_RATE_HOUR=60
# AI_RATE_SESSION=40
# Optional: Antwortlänge in Tokens, Zeitlimit pro Antwort in Millisekunden, gleichzeitige Anfragen
# AI_MAX_TOKENS=700
# AI_TIMEOUT_MS=15000
# AI_MAX_PARALLEL=6
